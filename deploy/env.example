# Nexent 部署环境变量（参考模板）
# 注意：仅作占位，实际命名以官方 deploy/env/.env.example 为准；
#       真实 Key 一律填入本地 .env，禁止提交入库。

# 镜像源与端口策略（官方支持 general / mainland / local-latest）
NEXENT_IMAGE_SOURCE=general
NEXENT_PORT_POLICY=development

# Web 入口
NEXENT_WEB_PORT=3000

# 模型接入（OpenAI 兼容；示例供应商 SiliconFlow / 阿里百炼）
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_API_KEY=sk-xxxx
LLM_MODEL=Qwen/Qwen2.5-72B-Instruct

VLM_BASE_URL=https://api.siliconflow.cn/v1
VLM_API_KEY=sk-xxxx
VLM_MODEL=Qwen/Qwen2-VL-72B-Instruct

EMBEDDING_BASE_URL=https://api.jina.ai/v1
EMBEDDING_API_KEY=jina_xxxx
EMBEDDING_MODEL=jina-embeddings-v3

# 可选的公网搜索供应商（场景以私有 KB 为主）
SEARCH_PROVIDER=
SEARCH_API_KEY=
